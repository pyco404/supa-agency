# Local-only configuration. Copy with umask 077; never commit .env.
# Existing exported variables override this file, including empty exports.
# Values are literal: no shell commands, interpolation or multiline values.
# Platform and website (loopback only)
SUPA_SITE_MODE=local
SUPA_SITE_ORIGIN=http://127.0.0.1:3200
SUPA_BIND=127.0.0.1:8080
SUPA_BACKEND_URL=http://127.0.0.1:8080
PORT=3200
SUPA_WEB_USERNAME=
SUPA_WEB_PASSWORD=
SUPA_API_TOKEN=
# Optional existing account JSON; never use real identities for local tests.
SUPA_WEB_OPERATORS=[]
SUPA_OPERATOR_CREDENTIALS=[]
SUPA_OPERATOR_SESSION_DEADLINES={}

# PostgreSQL: existing disposable local DB only. API startup can migrate it.
DATABASE_URL=

# OpenAI: optional preparation only; does not authorize paid requests.
OPENAI_API_KEY=
# Optional public project selection; not passed to offline processes.
OPENAI_PROJECT_ID=
OPENAI_MODEL=gpt-6-luna
OPENAI_COMPLEX_MODEL=gpt-6.1-sol
SUPA_PLANNING_MODE=routine
SUPA_MAX_OUTPUT_TOKENS=256
SUPA_LIVE_BUDGET_ID=
SUPA_LIVE_BUDGET_MICROUSD=0
SUPA_INPUT_RATE_MICROUSD_PER_MILLION=
SUPA_CACHED_RATE_MICROUSD_PER_MILLION=
SUPA_CACHE_WRITE_RATE_MICROUSD_PER_MILLION=
SUPA_OUTPUT_RATE_MICROUSD_PER_MILLION=

# Agent execution and spending: all opt-ins remain disabled.
SUPA_PROVIDER=offline
SUPA_ALLOW_OPENAI=false
SUPA_ALLOW_ANTHROPIC=false
SUPA_CONTROLLED_INFERENCE=false
SUPA_CONTROLLED_WORK=false
SUPA_SUPERVISED_REAL_MODEL=false
SUPA_WORKER_ENABLED=false
SUPA_API_SCHEDULER_ENABLED=false

# Solana and $SUPA: public identity and private path ONLY. Not launch authority.
SUPA_PLATFORM_MINT=SUPAojJGEuTrdknFuad7TSujxgU1x2Bz2ch2bZqFfqF
SUPA_PLATFORM_MINT_KEYPAIR_PATH=/home/pikoo/supa-mint/SUPAojJGEuTrdknFuad7TSujxgU1x2Bz2ch2bZqFfqF.json
SUPA_SOLANA_RPC_URL=
SUPA_WALLET_ENABLED=false
SUPA_WALLET_OPERATOR_ID=
SUPA_WALLET_READ_OPERATOR_ID=
SUPA_WALLET_VAULT_DIR=
SUPA_WALLET_MASTER_FILE=

# X: public metadata only. Secret and tokens stay in the encrypted keyring.
SUPA_X_CLIENT_ID=
SUPA_X_OWNER_ID=
SUPA_X_CALLBACK_URL=http://127.0.0.1:37641/oauth/x/callback
SUPA_X_USERNAME=supa_agency
SUPA_X_CREDENTIAL_CUSTODY=supa-agency/x/supa_agency
# Existing adapter uses tweet.read tweet.write users.read; no refresh token scope.

# Feature flags: configuration does not grant permissions or install identities.
SUPA_PRIVATE_STAGING=false
SUPA_PUBLIC_LANDING_ENABLED=false
SUPA_SYNTHETIC_FACTORY_ENABLED=false
SUPA_AGENT_AVATARS_ENABLED=false
SUPA_SUPERVISED_TASKS_ENABLED=false
SUPA_SOCIAL_REVIEW_ENABLED=false
