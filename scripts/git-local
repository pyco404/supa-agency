#!/usr/bin/env bash
# Use separate metadata; preserve the original read-only .git placeholder.
set -euo pipefail
project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
arguments=("$@")
command_index=0
if [[ ${arguments[0]:-} == --literal-pathspecs ]]; then command_index=1; fi
command_name=${arguments[$command_index]:-}
if [[ $command_name == create-beta-checkout ]]; then
    if [[ $command_index != 0 || $# != 2 ]]; then
        printf '%s\n' 'Use create-beta-checkout with the exact approved absolute destination.' >&2
        exit 1
    fi
    exec python3 "$project_root/scripts/create-beta-checkout.py" "${2}"
fi
if [[ $project_root == /home/pikoo/Desktop/supa-agent/artifacts/phase8-product-release-20261127/application-release && $command_name == push ]]; then
    if [[ $# != 4 || $1 != push || $2 != --no-follow-tags || $3 != origin || $4 != refs/heads/release/product-staging-20261127:refs/heads/release/product-staging-20261127 ]]; then
        printf '%s\n' 'Product release permits only its exact new-branch push.' >&2
        exit 1
    fi
    python3 "$project_root/scripts/git-policy.py" push-check "$4"
    exec git --git-dir="$project_root/.git-recovery" --work-tree="$project_root" "$@"
fi
if [[ $command_name == push ]]; then
    if [[ $command_index != 0 || $# != 4 || ${2:-} != --no-follow-tags || ${3:-} != origin || ( ${4:-} != refs/heads/main:refs/heads/main && ${4:-} != refs/heads/release/x-pilot-validation-20261121:refs/heads/release/x-pilot-validation-20261121 ) ]]; then
        printf '%s\n' 'Push requires an exact approved main or allowlisted release command, without force or tags.' >&2
        exit 1
    fi
    python3 "$project_root/scripts/git-policy.py" push-check "${4}"
fi
for argument in "$@"; do
    if [[ $argument == --squash || $argument == --autosquash || $argument == --amend ]]; then
        printf '%s\n' 'History combining and amendment are disabled by the one-file commit workflow.' >&2
        exit 1
    fi
done
if [[ $command_name == add ]]; then
    file_arguments=("${arguments[@]:$((command_index+1))}")
    if [[ ${file_arguments[0]:-} == -- ]]; then file_arguments=("${file_arguments[@]:1}"); fi
    if [[ ${#file_arguments[@]} != 1 ]]; then
        printf '%s\n' 'Stage exactly one explicitly named file.' >&2
        exit 1
    fi
    file_path=${file_arguments[0]}
    if [[ $file_path == -* || $file_path == /* || $file_path == .. || $file_path == ../* || $file_path == */../* || ! -f $project_root/$file_path || -L $project_root/$file_path ]]; then
        printf '%s\n' 'Only one exact project-relative regular-file path may be staged.' >&2
        exit 1
    fi
    exec git --git-dir="$project_root/.git-recovery" --work-tree="$project_root" --literal-pathspecs add -- "$file_path"
fi
exec git --git-dir="$project_root/.git-recovery" --work-tree="$project_root" "$@"
